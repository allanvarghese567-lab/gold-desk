# Free OANDA practice account: https://www.oanda.com (create a demo account, then
# My Hub > Manage API Access > generate a token). Account id looks like 101-001-1234567-001
OANDA_TOKEN=your_token_here
OANDA_ACCOUNT=101-001-0000000-001
OANDA_ENV=practice
# Put the same secret inside your TradingView alert message JSON
TV_WEBHOOK_SECRET=change-me
